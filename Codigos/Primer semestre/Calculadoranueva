#include <iostream>
using namespace std;

class Calculadora {
public:
    int sumar(int a, int b) {
        return a + b;
    }

    int restar(int a, int b) {
        return a - b;
    }

    int multiplicar(int a, int b) {
        return a * b;
    }

    int dividir(int a, int b) {
        return a / b;
    }
};

class CalculadoraNueva : public Calculadora {
};

int main() {
    CalculadoraNueva c;

    cout << c.sumar(5, 3) << endl;
    cout << c.restar(5, 3) << endl;
    cout << c.multiplicar(5, 3) << endl;
    cout << c.dividir(6, 3) << endl;

    return 0;
}